<workout_file>
    <author>TrainerPro</author>
    <name>Sweet Spot 3x10</name>
    <description>Classic sweet spot intervals: 3 x 10 min at 90% FTP with 5 min recoveries.</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.40" PowerHigh="0.70">
            <textevent timeoffset="30" message="Welcome! Ease into it."/>
            <textevent timeoffset="480" message="Almost warm — first interval soon."/>
        </Warmup>
        <IntervalsT Repeat="3" OnDuration="600" OffDuration="300" OnPower="0.90" OffPower="0.50" Cadence="90"/>
        <Cooldown Duration="420" PowerLow="0.65" PowerHigh="0.35">
            <textevent timeoffset="10" message="Nice work. Spin it out."/>
        </Cooldown>
    </workout>
</workout_file>
