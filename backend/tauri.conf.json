{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TrainerPro",
  "version": "0.1.0",
  "identifier": "com.trainerpro.desktop",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "TrainerPro",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "nsis", "msi"],
    "category": "HealthcareFitness",
    "shortDescription": "Indoor cycling workout player",
    "longDescription": "TrainerPro pairs a smart trainer and heart-rate monitor over Bluetooth, plays structured workouts in ERG mode, records the ride, and exports a Garmin-compatible FIT activity.",
    "publisher": "TrainerPro",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
