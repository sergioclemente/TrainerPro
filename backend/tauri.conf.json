{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TrainerPro",
  "version": "0.1.0",
  "identifier": "com.trainerpro.desktop",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run voice:models && npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "TrainerPro",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$RESOURCE/voice-models/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "resources": {
      "../BINARY_DISTRIBUTION_TERMS.md": "BINARY_DISTRIBUTION_TERMS.md",
      "../NOTICE.txt": "NOTICE.txt",
      "../legal/GEMMA_PROHIBITED_USE_POLICY_2024-02-21.txt": "legal/GEMMA_PROHIBITED_USE_POLICY_2024-02-21.txt",
      "../legal/GEMMA_TERMS_2026-04-01.txt": "legal/GEMMA_TERMS_2026-04-01.txt",
      "../voice-models/moonshine-small-streaming-en/": "voice-models/moonshine-small-streaming-en/",
      "../voice-models/embeddinggemma-300m/": "voice-models/embeddinggemma-300m/"
    },
    "targets": ["dmg", "app", "nsis", "msi"],
    "category": "HealthcareFitness",
    "shortDescription": "Indoor cycling workout player",
    "longDescription": "TrainerPro pairs a smart trainer and heart-rate monitor over Bluetooth, plays structured workouts in ERG mode, records the ride, and exports a Garmin-compatible FIT activity.",
    "publisher": "TrainerPro",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
